# Path to the SQLite database file (created on first run).
MOVIE_SHELF_DB=./data/movie-shelf.db

# Override only for testing / mirrors.
# IMDB_DATASETS_URL=https://datasets.imdbws.com

# TMDB v3 API key or v4 read access token (https://www.themoviedb.org/settings/api).
# Used only as a per-title fallback for original language. Optional.
TMDB_API_KEY=

# Sent to Wikidata / TMDB. Wikimedia recommends including contact info.
# HTTP_USER_AGENT=movie-shelf-mcp/0.1 (you@example.com)
